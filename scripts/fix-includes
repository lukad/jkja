#!/usr/bin/env python3
"""Rewrite #include lines to the repository's include convention.

Convention: a header that lives in this repository is included in quotes, by its
path relative to the including file, with forward slashes and the exact letter
case of the file on disk. No include directories are needed to find it.

For every #include in the C and C++ sources under src/, the named header is
looked up case-insensitively: relative to the including file, then relative to
src/, then by file name alone if exactly one tracked file has that name. If it
is found, the line is rewritten. Headers that are not in the repository (system
and third-party headers) are left alone.

Run without arguments to see what would change; run with --apply to change it.
Run it again after moving or renaming files.
"""

import os
import re
import subprocess
import sys

ROOT = "src"
SOURCE_SUFFIXES = (".c", ".cpp", ".h", ".hpp")
INCLUDE = re.compile(rb'^([ \t]*#[ \t]*include[ \t]*)(["<])([^">\r\n]+)([">])(.*)$')


def main():
    apply = "--apply" in sys.argv[1:]
    top = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True
    ).stdout.strip()
    os.chdir(top)
    listing = subprocess.run(["git", "ls-files", "-z", ROOT], capture_output=True, check=True)
    tracked = [f for f in listing.stdout.decode().split("\0") if f]

    by_lower = {f.lower(): f for f in tracked}
    by_name = {}
    for f in tracked:
        by_name.setdefault(os.path.basename(f).lower(), []).append(f)

    def find(includer, name):
        rel = name.replace("\\", "/")
        for base in (os.path.dirname(includer), ROOT):
            path = os.path.normpath(os.path.join(base, rel)).replace("\\", "/")
            if path.lower() in by_lower:
                return by_lower[path.lower()]
        candidates = by_name.get(os.path.basename(rel).lower(), [])
        if len(candidates) == 1:
            return candidates[0]
        if len(candidates) > 1:
            ambiguous.append(f"{includer}: {name} could be {' or '.join(candidates)}")
        return None

    rewritten = 0
    files_changed = 0
    ambiguous = []
    for f in tracked:
        if not f.lower().endswith(SOURCE_SUFFIXES):
            continue
        with open(f, "rb") as handle:
            lines = handle.read().split(b"\n")
        changed = False
        for i, line in enumerate(lines):
            m = INCLUDE.match(line)
            if not m:
                continue
            name = m.group(3).decode("latin-1")
            target = find(f, name)
            if target is None:
                continue
            new = os.path.relpath(target, os.path.dirname(f)).replace("\\", "/")
            if new == name and m.group(2) == b'"':
                continue
            if not apply:
                print(f'{f}:{i + 1}: {name} -> {new}')
            lines[i] = m.group(1) + b'"' + new.encode("latin-1") + b'"' + m.group(5)
            rewritten += 1
            changed = True
        if changed:
            files_changed += 1
            if apply:
                with open(f, "wb") as handle:
                    handle.write(b"\n".join(lines))

    for note in ambiguous:
        print(f"ambiguous, left alone: {note}", file=sys.stderr)
    verb = "rewrote" if apply else "would rewrite"
    print(f"{verb} {rewritten} include lines in {files_changed} files")
    return 1 if ambiguous else 0


if __name__ == "__main__":
    sys.exit(main())

{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "architecture": { "value": "x64", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "macos",
      "hidden": true,
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux x86-64, GCC, debug",
      "inherits": "linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux x86-64, GCC, release",
      "inherits": "linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-clang-debug",
      "displayName": "Linux x86-64, Clang, debug",
      "inherits": "linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "linux-sanitize",
      "displayName": "Linux x86-64, Clang, debug with AddressSanitizer and UBSan",
      "inherits": "linux-clang-debug",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fsanitize-recover=address -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fsanitize-recover=address -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "linux-sanitize-release",
      "displayName": "Linux x86-64, Clang, release with AddressSanitizer and UBSan",
      "inherits": "linux-sanitize",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "windows-debug",
      "displayName": "Windows x86-64, MSVC, debug",
      "inherits": "windows",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "windows-release",
      "displayName": "Windows x86-64, MSVC, release",
      "inherits": "windows",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "windows-cross-release",
      "displayName": "Windows x86-64 built on Linux, clang-cl, release, run under Wine",
      "inherits": "linux",
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-cross-clang-cl.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    },
    {
      "name": "macos-debug",
      "displayName": "macOS arm64, Apple Clang, debug",
      "inherits": "macos",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "macos-release",
      "displayName": "macOS arm64, Apple Clang, release",
      "inherits": "macos",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "RelWithDebInfo" }
    }
  ],
  "buildPresets": [
    { "name": "linux-debug", "configurePreset": "linux-debug" },
    { "name": "linux-release", "configurePreset": "linux-release" },
    { "name": "linux-clang-debug", "configurePreset": "linux-clang-debug" },
    { "name": "linux-sanitize", "configurePreset": "linux-sanitize" },
    { "name": "linux-sanitize-release", "configurePreset": "linux-sanitize-release" },
    { "name": "windows-debug", "configurePreset": "windows-debug" },
    { "name": "windows-release", "configurePreset": "windows-release" },
    { "name": "windows-cross-release", "configurePreset": "windows-cross-release" },
    { "name": "macos-debug", "configurePreset": "macos-debug" },
    { "name": "macos-release", "configurePreset": "macos-release" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true }
    },
    { "name": "linux-debug", "inherits": "base", "configurePreset": "linux-debug" },
    { "name": "linux-release", "inherits": "base", "configurePreset": "linux-release" },
    { "name": "linux-clang-debug", "inherits": "base", "configurePreset": "linux-clang-debug" },
    { "name": "linux-sanitize", "inherits": "base", "configurePreset": "linux-sanitize" },
    { "name": "linux-sanitize-release", "inherits": "base", "configurePreset": "linux-sanitize-release" },
    { "name": "windows-debug", "inherits": "base", "configurePreset": "windows-debug" },
    { "name": "windows-release", "inherits": "base", "configurePreset": "windows-release" },
    { "name": "windows-cross-release", "inherits": "base", "configurePreset": "windows-cross-release" },
    { "name": "macos-debug", "inherits": "base", "configurePreset": "macos-debug" },
    { "name": "macos-release", "inherits": "base", "configurePreset": "macos-release" }
  ]
}
